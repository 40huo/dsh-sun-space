{
  "name": "dsh-sun-space",
  "version": "0.2.1",
  "type": "module",
  "description": "Sun Space — personal super-agent on DeepSeek Harness (router/worker presets, dws source, vault, panel)",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./src/client.js",
    "./router-tools": "./lib/router-tools.mjs",
    "./worker-guard": "./lib/worker-guard.mjs",
    "./worker-vault": "./lib/worker-vault.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./bundle.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsdown": "^0.23.5",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsdown",
    "verify": "node verify.mjs",
    "sun:schedule": "node scripts/schedule-cli.mjs"
  },
  "files": [
    "lib",
    "src/client.js",
    "cordis.patch.yml",
    "bundle.patch.yml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/40huo/dsh-sun-space.git"
  },
  "license": "GPL-3.0-or-later",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}