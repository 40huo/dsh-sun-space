{
  "name": "sun-space",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sun Space — personal super-agent on DeepSeek Harness (router/worker presets, dws source, vault, panel)",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.js",
    "./router-tools": "./src/router-tools.ts",
    "./worker-guard": "./src/worker-guard.ts",
    "./source": "./src/source.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "scripts": {
    "test": "vitest run"
  }
}
